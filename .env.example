# Public origin of the deployed site. Used for canonical URLs, og:image,
# sitemap.xml and robots.txt — set it on every environment.
NEXT_PUBLIC_SITE_URL=https://arkomp.am

# Where the contact form forwards enquiries (Apps Script / Make / CRM endpoint
# that accepts JSON). Without it /api/contact answers 501 and the form tells the
# visitor to call instead.
# CONTACT_WEBHOOK_URL=

# Google Search Console HTML-tag verification (the content value only)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Catalogue API (github.com/SamGrig96/arkomp-api). Products, copy and photos are
# read from here; leave it empty and the site falls back to the copy bundled in
# src/lib/content. The host is also allow-listed for next/image.
NEXT_PUBLIC_API_URL=http://localhost:5080
